            <param name='image_column_4' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 4'/>
          </when>
          <when value='5'>
            <param name='image_column_1' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 1'/>
            <param name='image_column_2' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 2'/>
            <param name='image_column_3' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 3'/>
