            <param name='image_column_7' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 7'/>
            <param name='image_column_8' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Image column 8'/>
          </when>
          <when value='9'>
