  <inputs>
    <param name='input_csv' type='data' format='csv' label='Multimodal input dataset' help='CSV with features (and optional image paths)'/>
    <param name='target_column' type='data_column' data_ref='input_csv' use_header_names='true' numerical='false' label='Target Column' help='Column to predict'/>
    <param name='backbone_tabular' type='select' optional='true' label='Structured backbone' help='Structured/tabular backbone selection for AutoGluon'>
      <option value='categorical_mlp'>categorical_mlp - Custom MLP (no pretrained checkpoint; architecture only)</option>
      <option value='numerical_mlp'>numerical_mlp - Custom MLP (no pretrained checkpoint; architecture only)</option>
      <option value='ft_transformer' selected='true'>ft_transformer - Feature Tokenizer + Transformer</option>
    </param>
    <conditional name='test_dataset_conditional'>
      <param name='has_test_dataset' type='boolean' truevalue='yes' falsevalue='no' checked='false'
             label='Do you have a separate test dataset?' help='Switch to "Yes" to upload a dedicated test CSV; keep "No" to create a train/val split from the input dataset.'/>
      <when value='yes'>
        <param name='input_test' type='data' format='csv' label='Multimodal Test dataset' optional='true' help='If omitted, a split is created from the input dataset'/>
      </when>
      <when value='no'/>
    </conditional>
    <conditional name='use_images_conditional'>
      <param name='use_images' type='boolean' label='Use Images?' truevalue='yes' falsevalue='no' checked='false' help='Enable image processing'/>
